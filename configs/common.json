{
  "seed": 42,
  "rollout_scheduler": "per_task_async",
  "sampling_seed_protocol": "sha256(base_seed,task_uid,lineage,turn)",
  "steps": 400,
  "train_batch_size": 64,
  "mini_batch_tasks": 32,
  "micro_batch_size": 16,
  "micro_batch_token_limit": 24000,
  "learning_rate": 1e-06,
  "clip_low": 0.28,
  "clip_high": 0.28,
  "kl_coefficient": 0.001,
  "max_grad_norm": 1.0,
  "temperature": 1.0,
  "max_turns": 10,
  "max_response_tokens": 10240,
  "max_context_tokens": 32768,
  "initial_branches": 4,
  "flat_group_size": 4,
  "branch_factor": 2,
  "branch_interval": 5,
  "top_k_branches": 2,
  "prune_margin": 0.5,
  "repeat_limit": 11,
  "eval_samples": 4,
  "eval_temperature": 0.7,
  "eval_top_p": 0.8,
  "eval_top_k": 20,
  "eval_every": 25,
  "save_every": 10,
  "vllm_memory_fraction": 0.3,
  "vllm_max_sequences": 256,
  "is_slippery": false,
  "model_family": "Qwen3.5",
  "evaluate_extra_sets": false,
  "response_protocol": "first_complete_action_block",
  "ucf_v3": true,
  "ucf_beta": 0.25,
  "ucf_variant": "uniform",
  "ucf_target_forks": 2.0,
  "fork_point": "first_fence",
  "vllm_batch_invariant_scoped": true,
  "vllm_enforce_eager": false,
  "ucf_probability_source": "original_sampling_logits",
  "optimizer": "adamw"
}
